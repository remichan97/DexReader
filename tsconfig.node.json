{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vitest.config.ts",
    "vitest/vitest.main.config.ts",
    "vitest/setup.main.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/locales/**/*",
    "src/shared/**/*",
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  }
}

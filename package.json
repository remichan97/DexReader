{
  "name": "dexreader",
  "productName": "DexReader",
  "version": "1.12.0",
  "description": "A personal MangaDex client built with Electron and React.",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "remichan97",
  "homepage": "https://github.com/remichan97/dexreader",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:inspect": "electron-vite dev --inspect=5858",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "analyze:plans": "node scripts/run-analyze-plans.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:main": "vitest run --project=main",
    "test:renderer": "vitest run --project=renderer",
    "prepare": "husky"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fluentui/react-icons": "^2.0.315",
    "@types/bcrypt": "^6.0.0",
    "bcrypt-ts": "^8.0.1",
    "drizzle-orm": "^1.0.0-beta.22",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "i18next": "^26.0.10",
    "i18next-fs-backend": "^2.6.5",
    "pako": "^2.1.0",
    "protobufjs": "^8.6.6",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^6.30.4",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/i18next-fs-backend": "^1.1.5",
    "@types/node": "^22.18.6",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^1.0.0-beta.22",
    "electron": "^41.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.5",
    "vitest": "^4.1.10"
  }
}
